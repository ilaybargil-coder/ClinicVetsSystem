<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClinicVetsSystem.MainWindow"
        Title="ClinicVetsSystem"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#f2f4f6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="40,14,16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#191c1e"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, ComboBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#006c49"/>
        </Style>
        
        <Style Selector="Button.primary">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.chromeBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6c7a71"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Border.glassCard">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BoxShadow" Value="0 10 30 0 #08005236"/>
        </Style>

        <Style Selector="TextBlock.errorLabel">
            <Setter Property="Foreground" Value="#ba1a1a"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="4,4,0,8"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Image Source="avares://ClinicVetSystem/Assets/backgroundVETS.png"
               Stretch="UniformToFill"/>

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="TitleBar_PointerPressed" ZIndex="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,0" Spacing="4">
                <Button Classes="chromeBtn" Click="Minimize_Click"><PathIcon Data="M20,14H4V10H20" Width="12" Height="12"/></Button>
                <Button Classes="chromeBtn" Click="Maximize_Click"><PathIcon Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" Width="12" Height="12"/></Button>
                <Button Classes="chromeBtn closeBtn" Click="Close_Click"><PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="12" Height="12"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border MaxWidth="1000" Width="1000" MinHeight="680" Height="680"
                    CornerRadius="32" Background="Transparent" ClipToBounds="True" BoxShadow="0 24 64 0 #30005236, 0 4 16 0 #18005236">
                
                <Grid x:Name="ContainerGrid" ColumnDefinitions="*,*" SizeChanged="ContainerGrid_SizeChanged">
                    
                    <Panel x:Name="LeftPanel" Grid.Column="0" Background="Transparent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="48,32" MaxWidth="380" HorizontalAlignment="Center">
                                <TextBlock Text="Register Staff" FontSize="32" FontWeight="Bold" Foreground="#191c1e" Margin="0,0,0,8"/>
                                <TextBlock Text="Create a new clinician or administrative profile." FontSize="14" Foreground="#3c4a42" Margin="0,0,0,24"/>

                                <Border Background="#1Affdad6" CornerRadius="8" Margin="0,0,0,16" IsVisible="{Binding #lblRegMessage.IsVisible}">
                                    <TextBlock Name="lblRegMessage" Foreground="#ba1a1a" Padding="12" FontSize="13" FontWeight="Medium" IsVisible="False" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,6"/>
                                <Panel>
                                    <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                    <TextBox Name="txtRegUsername" Watermark="e.g. jsmith12"/>
                                </Panel>
                                <TextBlock Name="lblUsernameError" Classes="errorLabel" IsVisible="False"/>

                                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,6"/>
                                <Panel>
                                    <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                    <TextBox Name="txtRegPassword" PasswordChar="•" Watermark="••••••••••••">
                                        <TextBox.InnerRightContent>
                                            <Button Classes="chromeBtn" Tag="{Binding $parent[TextBox]}" Click="TogglePassword_Click" Margin="0,0,4,0">
                                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17C8.13,17 4.79,14.73 3,11.5C4.79,8.27 8.13,6 12,6C15.87,6 19.21,8.27 21,11.5C19.21,14.73 15.87,17 12,17M12,4.5C7,4.5 2.73,7.61 1,11.5C2.73,15.39 7,18.5 12,18.5C17,18.5 21.27,15.39 23,11.5C21.27,7.61 17,4.5 12,4.5Z" Width="18" Height="18"/>
                                            </Button>
                                        </TextBox.InnerRightContent>
                                    </TextBox>                                </Panel>
                                <TextBlock Name="lblPasswordError" Classes="errorLabel" IsVisible="False"/>

                                <TextBlock Text="ID NUMBER" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,6"/>
                                <Panel>
                                    <PathIcon Data="M2,3H22C23.05,3 24,3.95 24,5V19C24,20.05 23.05,21 22,21H2C0.95,21 0,20.05 0,19V5C0,3.95 0.95,3 2,3M14,6V7H22V6H14M14,8V9H21.5L22,9V8H14M14,10V11H21V10H14M8,13.91C6,13.91 2,15 2,17V18H14V17C14,15 10,13.91 8,13.91M8,6A3,3 0 0,0 5,9A3,3 0 0,0 8,12A3,3 0 0,0 11,9A3,3 0 0,0 8,6Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                    <TextBox Name="txtRegId" Watermark="012345678"/>
                                </Panel>
                                <TextBlock Name="lblIdError" Classes="errorLabel" IsVisible="False"/>

                                <TextBlock Text="EMAIL ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,6"/>
                                <Panel>
                                    <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                    <TextBox Name="txtRegEmail" Watermark="dr.green@clinic.com"/>
                                </Panel>
                                <TextBlock Name="lblEmailError" Classes="errorLabel" IsVisible="False"/>

                                <TextBlock Text="ROLE" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,6"/>
                                <ComboBox Name="cmbRegRole" PlaceholderText="Select Role" Margin="0,0,0,8">
                                    <ComboBoxItem Content="וטרינר/ית"/>
                                    <ComboBoxItem Content="מזכיר/ה"/>
                                </ComboBox>
                                <TextBlock Name="lblRoleError" Classes="errorLabel" IsVisible="False"/>

                                <Button Name="btnSubmitRegister" Classes="primary" Margin="0,16,0,32" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnSubmitRegister_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Offset="0" Color="#006c49"/>
                                            <GradientStop Offset="1" Color="#10b981"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Register &amp; Verify Email" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>

                    <Panel x:Name="RightPanel" Grid.Column="1" Background="#E8ffffff">
                        <StackPanel Margin="48,80" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                            
                            <TextBlock Text="Welcome Back" FontSize="36" FontWeight="Bold" Foreground="#191c1e" Margin="0,0,0,8"/>
                            <TextBlock Text="Please enter your clinician credentials to access the system." TextWrapping="Wrap" FontSize="15" Foreground="#3c4a42" Margin="0,0,0,40"/>

                            <Border Background="#1Affdad6" CornerRadius="8" Margin="0,0,0,16" IsVisible="{Binding #lblLoginMessage.IsVisible}">
                                <TextBlock Name="lblLoginMessage" Foreground="#ba1a1a" Padding="12" FontSize="13" FontWeight="Medium" IsVisible="False" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,8"/>
                            <Panel Margin="0,0,0,24">
                                <PathIcon Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                <TextBox Name="txtLoginUsername" Watermark="e.g. jsmith12"/>
                            </Panel>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0" Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Background="Transparent" Padding="0" Cursor="Hand" Click="btnForgotPassword_Click">
                                    <TextBlock Text="Forgot password?" FontSize="11" FontWeight="Bold" Foreground="#006c49" />
                                </Button>
                            </Grid>
                            <Panel Margin="0,0,0,40">
                                <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" Width="18" Height="18" Foreground="#bbcabf" HorizontalAlignment="Left" Margin="14,0,0,0" ZIndex="1"/>
                                <TextBox Name="txtLoginPassword" PasswordChar="•" Watermark="••••••••••••">
                                    <TextBox.InnerRightContent>
                                        <Button Classes="chromeBtn" Tag="{Binding $parent[TextBox]}" Click="TogglePassword_Click" Margin="0,0,4,0">
                                            <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17C8.13,17 4.79,14.73 3,11.5C4.79,8.27 8.13,6 12,6C15.87,6 19.21,8.27 21,11.5C19.21,14.73 15.87,17 12,17M12,4.5C7,4.5 2.73,7.61 1,11.5C2.73,15.39 7,18.5 12,18.5C17,18.5 21.27,15.39 23,11.5C21.27,7.61 17,4.5 12,4.5Z" Width="18" Height="18"/>
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Panel>

                            <Button Name="btnLoginSubmit" Classes="primary" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnLoginSubmit_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Offset="0" Color="#006c49"/>
                                        <GradientStop Offset="1" Color="#10b981"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="Enter Clinic Dashboard" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Panel>

                    <Border x:Name="OverlayPanel" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" ZIndex="10" 
                            Width="{Binding #LeftPanel.Bounds.Width}" BoxShadow="0 0 32 0 #40005236" RenderTransform="translateX(0px)">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#006c49"/>
                                <GradientStop Offset="1" Color="#00422b"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.7" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Border.Transitions>

                        <Grid Margin="40">
                            <StackPanel x:Name="OverlayLeftContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.4"/></Transitions></StackPanel.Transitions>
                                <TextBlock Text="🐾" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                <TextBlock Text="Restoring Vitality" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="New to the greenhouse? Register your staff profile to start optimizing pet care." 
                                           FontSize="16" Foreground="#CCFFFFFF" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,0,0,40" LineHeight="24"/>
                                <Button Classes="outline" Content="CREATE ACCOUNT" HorizontalAlignment="Center" Click="ToggleSlide_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="OverlayRightContent" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                <StackPanel.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.4"/></Transitions></StackPanel.Transitions>
                                <TextBlock Text="🩺" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                <TextBlock Text="Already a Member?" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="Welcome back! Please sign in to access your dashboard and daily schedule." 
                                           FontSize="16" Foreground="#CCFFFFFF" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,0,0,40" LineHeight="24"/>
                                <Button Classes="outline" Content="SIGN IN" HorizontalAlignment="Center" Click="ToggleSlide_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </Grid>
            </Border>
        </Grid>
        
        <Grid Name="ModalOverlay" Grid.RowSpan="2" Background="#C0000000" IsVisible="False" ZIndex="100">
            <Button Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnCancelModal_Click"/>
            
            <Border Name="pnlRequestReset" Classes="glassCard" Width="400" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="Reset Password" FontSize="24" FontWeight="Black" Foreground="#191c1e" HorizontalAlignment="Center"/>
                    <TextBlock Text="Enter your registered email address to receive a 6-digit verification code." FontSize="14" Foreground="#64748b" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <TextBox Name="txtResetEmail" Watermark="e.g. name@clinic.com" Background="#f2f4f6" BorderThickness="0" CornerRadius="8" Padding="16,12"/>
                    <TextBlock Name="lblResetError" Classes="errorLabel" IsVisible="False"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,16,0,0">
                        <Button Grid.Column="0" Content="Cancel" Click="btnCancelModal_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#f1f5f9" Foreground="#475569" CornerRadius="8" Height="40"/>
                        <Button Grid.Column="1" Content="Send OTP" Click="btnSendResetOtp_Click" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Offset="0" Color="#006c49"/><GradientStop Offset="1" Color="#10b981"/></LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Name="pnlVerifyOtp" Classes="glassCard" Width="400" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="Verify Email" FontSize="24" FontWeight="Black" Foreground="#191c1e" HorizontalAlignment="Center"/>
                    <TextBlock Text="We've sent a 6-digit code to your email. Enter it below to continue." FontSize="14" Foreground="#64748b" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <TextBox Name="txtOtpCode" Watermark="000000" MaxLength="6" TextAlignment="Center" FontSize="24" FontWeight="Bold" LetterSpacing="8" Background="#f2f4f6" BorderThickness="0" CornerRadius="8" Padding="16,12"/>
                    <TextBlock Name="lblOtpError" Classes="errorLabel" IsVisible="False" HorizontalAlignment="Center"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,16,0,0">
                        <Button Grid.Column="0" Content="Cancel" Click="btnCancelModal_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#f1f5f9" Foreground="#475569" CornerRadius="8" Height="40"/>
                        <Button Grid.Column="1" Content="Verify Code" Click="btnVerifyOtp_Click" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Offset="0" Color="#006c49"/><GradientStop Offset="1" Color="#10b981"/></LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Name="pnlNewPassword" Classes="glassCard" Width="400" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create New Password" FontSize="24" FontWeight="Black" Foreground="#191c1e" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your new password must be 8-10 characters and include a number, letter, and a special character ($#!)." FontSize="12" Foreground="#64748b" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="NEW PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,-12"/>
                    <TextBox Name="txtNewPassword" PasswordChar="•" Watermark="••••••••••••" Background="#f2f4f6" BorderThickness="0" CornerRadius="8" Padding="16,12">
                        <TextBox.InnerRightContent>
                            <Button Classes="chromeBtn" Tag="{Binding $parent[TextBox]}" Click="TogglePassword_Click" Margin="0,0,4,0">
                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17C8.13,17 4.79,14.73 3,11.5C4.79,8.27 8.13,6 12,6C15.87,6 19.21,8.27 21,11.5C19.21,14.73 15.87,17 12,17M12,4.5C7,4.5 2.73,7.61 1,11.5C2.73,15.39 7,18.5 12,18.5C17,18.5 21.27,15.39 23,11.5C21.27,7.61 17,4.5 12,4.5Z" Width="18" Height="18"/>
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    
                    <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#3c4a42" LetterSpacing="1" Margin="0,0,0,-12"/>
                    <TextBox Name="txtConfirmNewPassword" PasswordChar="•" Watermark="••••••••••••" Background="#f2f4f6" BorderThickness="0" CornerRadius="8" Padding="16,12">
                        <TextBox.InnerRightContent>
                            <Button Classes="chromeBtn" Tag="{Binding $parent[TextBox]}" Click="TogglePassword_Click" Margin="0,0,4,0">
                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17C8.13,17 4.79,14.73 3,11.5C4.79,8.27 8.13,6 12,6C15.87,6 19.21,8.27 21,11.5C19.21,14.73 15.87,17 12,17M12,4.5C7,4.5 2.73,7.61 1,11.5C2.73,15.39 7,18.5 12,18.5C17,18.5 21.27,15.39 23,11.5C21.27,7.61 17,4.5 12,4.5Z" Width="18" Height="18"/>
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>                    
                    <TextBlock Name="lblNewPasswordError" Classes="errorLabel" IsVisible="False"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,16,0,0">
                        <Button Grid.Column="0" Content="Cancel" Click="btnCancelModal_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#f1f5f9" Foreground="#475569" CornerRadius="8" Height="40"/>
                        <Button Grid.Column="1" Content="Update Password" Click="btnSaveNewPassword_Click" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Offset="0" Color="#006c49"/><GradientStop Offset="1" Color="#10b981"/></LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Panel>
</Window>