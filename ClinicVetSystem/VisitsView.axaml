<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetsSystem.VisitsView"
             FontFamily="Inter, sans-serif">

    <UserControl.Styles>

        <Style Selector="Border.glassCard">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BoxShadow" Value="0 10 30 0 #08005236"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primaryAction:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Tab buttons -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#006c49"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e2e8f0"/>
        </Style>

        <!-- Diagnosis text area -->
        <Style Selector="TextBox.diagnosisInput">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.diagnosisInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#006c49"/>
        </Style>

    </UserControl.Styles>

    <!-- ════════════════════════════════════════════════════════ -->
    <!--  ROOT  —  2-column: patient list | medical record      -->
    <!-- ════════════════════════════════════════════════════════ -->
    <Grid ColumnDefinitions="360, *" Margin="32,24,32,32" ColumnSpacing="24">

        <!-- ══════════════════════════════════════ -->
        <!--  LEFT — patient list                  -->
        <!-- ══════════════════════════════════════ -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" RowSpacing="14">

            <!-- Header: title + vet badge -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="תיקים רפואיים"
                               FontSize="28" FontWeight="Black" Foreground="#006c49"/>
                    <TextBlock Name="lblSubtitle" FontSize="13" Foreground="#64748b"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#f0fdf4" CornerRadius="20"
                        Padding="14,10" VerticalAlignment="Center">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Name="lblVetBadge" FontSize="12" FontWeight="Bold"
                                   Foreground="#006c49" HorizontalAlignment="Center"/>
                        <TextBlock Text="וטרינר/ית" FontSize="10" Foreground="#64748b"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tab buttons: Today / History -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0" Name="btnTabToday"
                        Classes="tabBtn active" Click="BtnTabToday_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBlock Text="היום" VerticalAlignment="Center"/>
                        <Border Name="badgeToday" Background="#10b981"
                                CornerRadius="10" Padding="8,2">
                            <TextBlock Name="lblTodayCount" Text="0"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Name="btnTabHistory"
                        Classes="tabBtn" Click="BtnTabHistory_Click"
                        Content="היסטוריה"/>
            </Grid>

            <!-- Scrollable patient list -->
            <Border Grid.Row="2" Classes="glassCard" Padding="0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="PatientList" Spacing="0"/>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  RIGHT — medical record panel                         -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Classes="glassCard" Padding="0" ClipToBounds="True">
            <Grid>

                <!-- ── Empty state ─────────────────────────────── -->
                <StackPanel Name="RecordEmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="16">
                    <TextBlock Text="🩺" FontSize="64"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="בחר מטופל מהרשימה"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#64748b"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="לחץ על שם מטופל כדי לפתוח את הרשומה הרפואית"
                               FontSize="13" Foreground="#94a3b8"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ── Medical record ──────────────────────────── -->
                <ScrollViewer Name="RecordPanel" IsVisible="False"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,32,36,36" Spacing="24">

                        <!-- Patient header -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="20">
                            <Border Grid.Column="0" Name="PatientAvatarBorder"
                                    Width="76" Height="76" CornerRadius="22">
                                <TextBlock Name="lblPatientEmoji" FontSize="34"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Name="lblPatientName"
                                           FontSize="22" FontWeight="Black"
                                           Foreground="#1e293b"/>
                                <TextBlock Name="lblPatientOwner"
                                           FontSize="13" Foreground="#64748b"/>
                                <TextBlock Name="lblVisitDateTime"
                                           FontSize="12" Foreground="#94a3b8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Vaccine warning banner (hidden until needed) -->
                        <Border Name="VaccineWarningPanel" IsVisible="False"
                                Background="#fef9c3" CornerRadius="16" Padding="18,12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="חיסון שנתי פג תוקף!"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#92400e"/>
                                    <TextBlock Name="lblVaccineWarning"
                                               FontSize="12" Foreground="#a16207"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Border Height="1" Background="#f1f5f9"/>

                        <!-- ─── STEP 1: Reason (vet fills in) ───── -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="#006c49" CornerRadius="8"
                                        Padding="8,4">
                                    <TextBlock Text="1" FontSize="12"
                                               FontWeight="Black" Foreground="White"/>
                                </Border>
                                <TextBlock Text="סיבת הביקור"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Name="txtReason" Classes="diagnosisInput"
                                     Height="80" AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Watermark="רשום את סיבת הביקור..."/>
                        </StackPanel>

                        <!-- ─── STEP 2: Diagnosis ───────────────── -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="#006c49" CornerRadius="8"
                                        Padding="8,4">
                                    <TextBlock Text="2" FontSize="12"
                                               FontWeight="Black" Foreground="White"/>
                                </Border>
                                <TextBlock Text="אבחנה רפואית"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Name="txtDiagnosis" Classes="diagnosisInput"
                                     Height="110" AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Watermark="רשום אבחנה רפואית מפורטת..."/>
                        </StackPanel>

                        <!-- ─── STEP 3: Medications ─────────────── -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="#006c49" CornerRadius="8"
                                        Padding="8,4">
                                    <TextBlock Text="3" FontSize="12"
                                               FontWeight="Black" Foreground="White"/>
                                </Border>
                                <TextBlock Text="תרופות"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="לחץ לבחירה"
                                           FontSize="11" Foreground="#94a3b8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Medication rows built in code -->
                            <StackPanel Name="MedicationsList" Spacing="8"/>
                        </StackPanel>

                        <!-- ─── STEP 4: Cost breakdown ──────────── -->
                        <Border Background="#f0fdf4" CornerRadius="20" Padding="24,20">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="#006c49" CornerRadius="8"
                                            Padding="8,4">
                                        <TextBlock Text="4" FontSize="12"
                                                   FontWeight="Black" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="עלות כוללת"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#006c49"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <TextBlock Text="ביקור בסיסי:"
                                               FontSize="13" Foreground="#64748b"/>
                                    <TextBlock Name="lblBaseCost" Grid.Column="1"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1e293b"/>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="תרופות:"
                                               FontSize="13" Foreground="#64748b"/>
                                    <TextBlock Name="lblMedsCost" Grid.Column="1"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1e293b"/>
                                </Grid>
                                <Border Height="1" Background="#bbf7d0"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="סה&quot;כ לתשלום:"
                                               FontSize="16" FontWeight="Black"
                                               Foreground="#006c49"/>
                                    <TextBlock Name="lblTotalCost" Grid.Column="1"
                                               FontSize="22" FontWeight="Black"
                                               Foreground="#006c49"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save button + status -->
                        <TextBlock Name="lblSaveStatus" IsVisible="False"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>

                        <Button Name="btnSaveRecord" Classes="primaryAction"
                                Padding="0,16"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="BtnSaveRecord_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#006c49" Offset="0"/>
                                    <GradientStop Color="#10b981" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="שמור רשומה רפואית ✓"
                                       FontSize="15" FontWeight="Bold"/>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</UserControl>
