<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClinicVetSystem.VisitsView">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="ניהול ביקור וטיפול" FontSize="20" FontWeight="Bold" Foreground="#006c49"/>
        
        <TextBox Name="txtDiagnosis" Watermark="הזן אבחנה רפואית..." Height="100" AcceptsReturn="True"/>
        
        <TextBlock Text="בחירת תרופות מהמלאי:" FontWeight="SemiBold"/>
        <ListBox Name="lstMedications" Height="150" SelectionMode="Multiple"/>
        
        <Border Background="#f0fdf4" Padding="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Name="lblTotalPrice" Text="סה''כ לתשלום: ₪ 0" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button Content="חישוב עלות סופית" Background="#006c49" Foreground="White"/>
            </StackPanel>
        </Border>
        
        <Button Content="שמור סיכום ביקור" HorizontalAlignment="Right" Classes="accent"/>
    </StackPanel>
</UserControl>