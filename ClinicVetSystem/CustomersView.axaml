<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ClinicVetsSystem"
             x:Class="ClinicVetsSystem.CustomersView"
             FontFamily="Inter, sans-serif">

    <UserControl.Styles>

        <Style Selector="Border.glassCard">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BoxShadow" Value="0 10 30 0 #08005236"/>
        </Style>

        <Style Selector="TextBox.formInput">
            <Setter Property="Background" Value="#f2f4f6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.formInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#006c49"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primaryAction:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.dangerBtn">
            <Setter Property="Background" Value="#fef2f2"/>
            <Setter Property="Foreground" Value="#dc2626"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dangerBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#fee2e2"/>
        </Style>

        <Style Selector="Button.secondaryBtn">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondaryBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e2e8f0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f8fafc"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#f0fdf4"/>
        </Style>

    </UserControl.Styles>

    <Grid>

        <Grid ColumnDefinitions="380, *" Margin="32,24,32,32" ColumnSpacing="24">

            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *, Auto" RowSpacing="14">

                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="ניהול לקוחות"
                                   FontSize="28" FontWeight="Black" Foreground="#006c49"/>
                        <TextBlock Name="lblCustomerCount"
                                   FontSize="13" Foreground="#64748b"/>
                    </StackPanel>

                    <Button Grid.Column="1" Name="btnAddCustomer"
                            Classes="primaryAction" Padding="18,12"
                            Click="btnAddCustomer_Click" VerticalAlignment="Center">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#006c49" Offset="0"/>
                                <GradientStop Color="#10b981" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontSize="18" FontWeight="Black"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="לקוח חדש" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Classes="glassCard" Padding="4,2">
                    <TextBox Name="txtSearch" Background="Transparent" BorderThickness="0"
                             Padding="14,12" FontSize="14"
                             Watermark="🔍  חיפוש לפי שם, ת.ז. או טלפון..."
                             TextChanged="txtSearch_TextChanged"/>
                </Border>

                <Border Grid.Row="2" Classes="glassCard" Padding="0" ClipToBounds="True">
                    <ListBox Name="lstCustomers" Background="Transparent" BorderThickness="0"
                             SelectionChanged="lstCustomers_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:CustomerRow">
                                <Grid ColumnDefinitions="Auto, *"
                                      Margin="16,10,16,10" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            Width="44" Height="44" CornerRadius="14"
                                            Background="#f0fdf4">
                                        <TextBlock Text="{Binding FirstLetter}"
                                                   FontSize="18" FontWeight="Black"
                                                   Foreground="#006c49"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#1e293b"/>
                                        <TextBlock Text="{Binding Phone}"
                                                   FontSize="12" Foreground="#64748b"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="3" Name="lblStatus"
                           FontSize="11" Foreground="#94a3b8"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border Grid.Column="1" Classes="glassCard" Padding="0" ClipToBounds="True">
                <Grid>

                    <StackPanel Name="EmptyStatePanel"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="16">
                        <TextBlock Text="👤" FontSize="64"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="בחר לקוח מהרשימה"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="לחץ על לקוח כדי לראות את הפרופיל המלא שלו"
                                   FontSize="13" Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Name="ProfilePanel" IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,32,36,36" Spacing="24">

                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <Border Name="AvatarBorder" Width="80" Height="80"
                                        CornerRadius="24" Background="#f0fdf4">
                                    <TextBlock Name="lblInitials"
                                               FontSize="28" FontWeight="Black"
                                               Foreground="#006c49"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Name="lblProfileName"
                                               FontSize="22" FontWeight="Black"
                                               Foreground="#1e293b"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="ת.ז.:" FontSize="13"
                                                   Foreground="#94a3b8"/>
                                        <TextBlock Name="lblProfileId"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#64748b"/>
                                    </StackPanel>
                                    <TextBlock Name="lblProfileSince"
                                               FontSize="12" Foreground="#94a3b8"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Border Grid.Column="0" Background="#f8fafc"
                                        CornerRadius="20" Padding="20,16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="📞  טלפון"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#64748b"/>
                                        <TextBlock Name="lblProfilePhone"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#1e293b"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#f8fafc"
                                        CornerRadius="20" Padding="20,16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="📧  אימייל"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#64748b"/>
                                        <TextBlock Name="lblProfileEmail"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#1e293b"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="חיות מחמד"
                                                   FontSize="16" FontWeight="Black"
                                                   Foreground="#1e293b"/>
                                        <TextBlock Name="lblPetCount"
                                                   FontSize="12" Foreground="#64748b"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Name="btnAddPet"
                                            Classes="primaryAction"
                                            Padding="14,10" FontSize="13"
                                            Click="BtnAddPet_Click"
                                            VerticalAlignment="Center">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#006c49" Offset="0"/>
                                                <GradientStop Color="#10b981" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="+" FontSize="16" FontWeight="Black"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="הוסף חיה" FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Name="PetsList" Spacing="10"/>
                            </StackPanel>

                            <Border Height="1" Background="#f1f5f9"/>

                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">
                                <Button Grid.Column="0" Content="✏  עריכה"
                                        Classes="secondaryBtn"
                                        Click="BtnEditProfile_Click"/>
                                
                                <Button Grid.Column="1" Content="📅  תורים"
                                        Classes="secondaryBtn"
                                        Background="#e0e7ff" Foreground="#4f46e5"
                                        Click="btnManageAppointments_Click"/>
                                        
                                <Button Grid.Column="2" Content="🗑  מחיקה"
                                        Classes="dangerBtn"
                                        Click="BtnDeleteProfile_Click"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <Grid Name="ModalOverlay" IsVisible="False" Background="#80000000" ZIndex="100">
            <Button Background="Transparent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Click="btnCancelDialog_Click"/>

            <Border Classes="glassCard" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40">
                <StackPanel Spacing="8">
                    <TextBlock Name="lblDialogTitle" Text="רישום לקוח חדש"
                               FontSize="24" FontWeight="Black" Foreground="#1e293b"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="מספר תעודת זהות" FontSize="11" FontWeight="Bold"
                               Foreground="#64748b" LetterSpacing="0.5"/>
                    <TextBox Name="txtDialogId" Classes="formInput"
                             Watermark="9 ספרות" Margin="0,4,0,12"/>

                    <TextBlock Text="שם מלא" FontSize="11" FontWeight="Bold"
                               Foreground="#64748b" LetterSpacing="0.5"/>
                    <TextBox Name="txtDialogName" Classes="formInput"
                             Watermark="שם פרטי ושם משפחה" Margin="0,4,0,12"/>

                    <TextBlock Text="מספר טלפון" FontSize="11" FontWeight="Bold"
                               Foreground="#64748b" LetterSpacing="0.5"/>
                    <TextBox Name="txtDialogPhone" Classes="formInput"
                             Watermark="05X-XXXXXXX" Margin="0,4,0,12"/>

                    <TextBlock Text="כתובת אימייל (אופציונלי)" FontSize="11" FontWeight="Bold"
                               Foreground="#64748b" LetterSpacing="0.5"/>
                    <TextBox Name="txtDialogEmail" Classes="formInput"
                             Watermark="name@example.com" Margin="0,4,0,0"/>

                    <TextBlock Name="lblDialogError"
                               Foreground="#dc2626" FontSize="12"
                               IsVisible="False" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*, *" Margin="0,20,0,0" ColumnSpacing="14">
                        <Button Grid.Column="0" Content="ביטול"
                                Click="btnCancelDialog_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="#f1f5f9" Foreground="#475569"
                                CornerRadius="14" Height="48" Cursor="Hand"/>
                        <Button Grid.Column="1" Name="btnSaveDialog"
                                Click="btnSaveDialog_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="primaryAction" Height="48">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#006c49" Offset="0"/>
                                    <GradientStop Color="#10b981" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Name="lblSaveBtn" Text="שמור לקוח"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Name="AddPetOverlay" IsVisible="False" Background="#BB000000" ZIndex="100">
            <Border Classes="glassCard" Width="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40">
                <StackPanel Spacing="0">

                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="הוסף חיה ללקוח"
                                       FontSize="22" FontWeight="Black" Foreground="#006c49"/>
                            <TextBlock Name="lblAddPetSubtitle"
                                       FontSize="13" Foreground="#64748b" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Background="Transparent" Foreground="#94a3b8"
                                CornerRadius="10" Padding="8,4" FontSize="16"
                                VerticalAlignment="Top" Cursor="Hand"
                                Click="CloseAddPet_Click"/>
                    </Grid>

                    <Border Height="1" Background="#f1f5f9" Margin="0,14,0,20"/>

                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="שם החיה" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748b"/>
                                <TextBox Name="txtAddPetName" Classes="formInput"
                                         Watermark="למשל: באדי"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="סוג חיה" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748b"/>
                                <ComboBox Name="cbAddPetType" Classes="formInput"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="בחר סוג..."/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="משקל (ק&quot;ג)" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748b"/>
                                <TextBox Name="txtAddPetWeight" Classes="formInput"
                                         Watermark="0.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="מספר שבב (אופציונלי)" FontSize="11"
                                           FontWeight="Bold" Foreground="#64748b"/>
                                <TextBox Name="txtAddPetChip" Classes="formInput"
                                         Watermark="מספר שבב..."/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="תאריך לידה" FontSize="11" FontWeight="Bold"
                                           Foreground="#64748b"/>
                                <DatePicker Name="dpAddPetBirth" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="חיסון אחרון (אופציונלי)" FontSize="11"
                                           FontWeight="Bold" Foreground="#64748b"/>
                                <DatePicker Name="dpAddPetVaccine" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Name="lblAddPetError" IsVisible="False"
                                   Foreground="#dc2626" FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0,8,0,0">
                            <Button Grid.Column="0" Content="ביטול"
                                    Click="CloseAddPet_Click"
                                    Background="#f1f5f9" Foreground="#64748b"
                                    CornerRadius="14" Padding="0,13"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"/>
                            <Button Grid.Column="1" Name="btnSaveAddPet"
                                    Content="שמור חיה ✓"
                                    Classes="primaryAction" Padding="28,13"
                                    Click="BtnSaveAddPet_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#006c49" Offset="0"/>
                                        <GradientStop Color="#10b981" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Name="AppointmentManagerModal" IsVisible="False" Background="#BB000000" ZIndex="100">
            <Border Classes="glassCard" Width="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40" MaxHeight="700">
                <StackPanel Spacing="0">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ניהול תורים וביקורים"
                                       FontSize="22" FontWeight="Black" Foreground="#006c49"/>
                            <TextBlock Name="lblApptCustomerName"
                                       FontSize="13" Foreground="#64748b" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Background="Transparent" Foreground="#94a3b8"
                                CornerRadius="10" Padding="8,4" FontSize="16"
                                VerticalAlignment="Top" Cursor="Hand"
                                Click="btnCloseAppointments_Click"/>
                    </Grid>

                    <Border Height="1" Background="#f1f5f9" Margin="0,14,0,20"/>

                    <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">

                            <!-- Upcoming appointments -->
                            <TextBlock Text="📅 תורים עתידיים" FontSize="14"
                                       FontWeight="Bold" Foreground="#1e293b"/>
                            <Border Background="#f8fafc" CornerRadius="12" Padding="8" MinHeight="60">
                                <ListBox Name="lstUpcoming" Background="Transparent"
                                         BorderThickness="0" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:AppointmentDisplayRow">
                                            <Grid ColumnDefinitions="*, Auto" Margin="4,6">
                                                <StackPanel Grid.Column="0"
                                                            VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding DisplayDate}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="#006c49"/>
                                                        <TextBlock Text="{Binding PetName}"
                                                                   FontSize="12" Foreground="#64748b"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}"
                                                               FontSize="12" Foreground="#94a3b8"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="❌ ביטול"
                                                        Click="btnCancelAppointment_Click"
                                                        Tag="{Binding Id}"
                                                        Classes="dangerBtn"
                                                        Padding="12,6" FontSize="12"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Visit history -->
                            <TextBlock Text="🕒 היסטוריית ביקורים" FontSize="14"
                                       FontWeight="Bold" Foreground="#1e293b" Margin="0,10,0,0"/>
                            <Border Background="#f8fafc" CornerRadius="12" Padding="8" MinHeight="60">
                                <ListBox Name="lstHistory" Background="Transparent"
                                         BorderThickness="0" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:AppointmentDisplayRow">
                                            <StackPanel Margin="4,4" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayDate}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#1e293b"/>
                                                    <TextBlock Text="{Binding PetName}"
                                                               FontSize="12" Foreground="#64748b"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="12" Foreground="#94a3b8"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Status label -->
                            <TextBlock Name="lblApptStatus" IsVisible="False"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Center" Margin="0,4,0,0"/>

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0,10,0,0">
                                <Button Grid.Column="0" Content="סגור"
                                        Click="btnCloseAppointments_Click"
                                        Background="#f1f5f9" Foreground="#64748b"
                                        CornerRadius="14" Padding="0,13"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Cursor="Hand"/>
                                <Button Grid.Column="1"
                                        Content="➕ תור חדש"
                                        Classes="primaryAction" Padding="28,13"
                                        Click="btnGoToNewAppointment_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#006c49" Offset="0"/>
                                            <GradientStop Color="#10b981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>