<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClinicVetsSystem"
        x:Class="ClinicVetsSystem.MainMenuWindow"
        Title="ClinicVetsSystem - Staff Dashboard"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#f7f9fb"
        FontFamily="Inter, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <Style Selector="Button.chromeBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6c7a71"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chromeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#e0e3e5"/>
            <Setter Property="Foreground" Value="#191c1e"/>
        </Style>

        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="CornerRadius" Value="0,32,32,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#ecfdf5"/>
            <Setter Property="Foreground" Value="#059669"/>
        </Style>
        <Style Selector="Button.navBtn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#d1fae5"/>
            <Setter Property="Foreground" Value="#047857"/>
        </Style>

        <Style Selector="Border.glassCard">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BoxShadow" Value="0 10 30 0 #08005236"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primaryAction:pointerover">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280, *">
        
        <Border Grid.Column="0" BorderBrush="#eef2f6" BorderThickness="0,0,1,0" ZIndex="10" ClipToBounds="True">
            <Panel>
                <Image Source="avares://ClinicVetSystem/Assets/sidebarnew.png" Stretch="UniformToFill"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#33ffffff"/>
                            <GradientStop Offset="1" Color="#33f0fdf4"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Grid.Row="0" Margin="32,40,24,32" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#006c49" CornerRadius="12" Width="40" Height="40" BoxShadow="0 4 12 0 #33006c49">
                            <TextBlock Text="🐾" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                        </Border>
                        <TextBlock Text="ClinicVetsSystem" FontSize="18" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Nature's Vitality Care" FontSize="12" FontWeight="Medium" Foreground="#64748b" Margin="52,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,24,0">
                    <Button Name="btnNavDashboard" Classes="navBtn active" Click="btnNavDashboard_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Width="20" Height="20"/>
                            <TextBlock Text="DASHBOARD" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnNavCustomers" Classes="navBtn" Click="btnNavCustomers_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Width="20" Height="20"/>
                            <TextBlock Text="CUSTOMERS" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnNavPets" Classes="navBtn" Click="btnPets_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M12,2A2,2 0 0,1 14,4A2,2 0 0,1 12,6A2,2 0 0,1 10,4A2,2 0 0,1 12,2M16,5A2,2 0 0,1 18,7A2,2 0 0,1 16,9A2,2 0 0,1 14,7A2,2 0 0,1 16,5M8,5A2,2 0 0,1 10,7A2,2 0 0,1 8,9A2,2 0 0,1 6,7A2,2 0 0,1 8,5M19.14,12.5C18.66,13.63 17.66,14.5 16.5,15C16.5,16.5 16.5,18.5 15,20C13.5,21.5 12,22 12,22C12,22 10.5,21.5 9,20C7.5,18.5 7.5,16.5 7.5,15C6.34,14.5 5.34,13.63 4.86,12.5C4,10.5 4.5,8 5.5,8C6.5,8 7,9 8,10C9,11 10.5,11.5 12,11.5C13.5,11.5 15,11 16,10C17,9 17.5,8 18.5,8C19.5,8 20,10.5 19.14,12.5Z" Width="20" Height="20"/>
                            <TextBlock Text="PETS" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnNavVisits" Classes="navBtn" Click="btnVisits_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Width="20" Height="20"/>
                            <TextBlock Text="VISITS" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnCalender" Classes="navBtn" Click="BtnCalender_OnClick_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Width="20" Height="20"/>
                            <TextBlock Text="Calender" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnInventory" Classes="navBtn" Click="btnInventory_Click">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-.9-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4h16v3z" Width="20" Height="20"/>
                            <TextBlock Text="INVENTORY" FontWeight="Bold" FontSize="13" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="24,0,24,32" Spacing="32">
                    <Border CornerRadius="16" BoxShadow="0 8 20 0 #2010b981">
                        <Button Name="btnSidebarNewAppt" Classes="primaryAction" Height="56"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="BtnSidebarNewAppt_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#006c49"/>
                                    <GradientStop Offset="1" Color="#10b981"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" Width="20" Height="20" Foreground="White"/>
                                <TextBlock Text="New Appointment" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    
                    <StackPanel Spacing="4">
                        <Button Name="btnLogout" Background="Transparent" Foreground="#64748b" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12" Click="btnLogout_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <PathIcon Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" Width="20" Height="20"/>
                                <TextBlock Text="LOGOUT" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Panel>
        </Border>

        <Panel Grid.Column="1">
            <Image Source="avares://ClinicVetSystem/Assets/mainPagesBackground.png" Stretch="UniformToFill" HorizontalAlignment="Right"/>
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" Height="40" Background="Transparent" PointerPressed="TitleBar_PointerPressed" ZIndex="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,16,0" Spacing="8">
                        <Button Classes="chromeBtn" Click="Minimize_Click"><PathIcon Data="M20,14H4V10H20" Width="10" Height="10"/></Button>
                        <Button Classes="chromeBtn" Click="Maximize_Click"><PathIcon Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" Width="10" Height="10"/></Button>
                        <Button Classes="chromeBtn" Click="Close_Click"><PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="10" Height="10"/></Button>
                    </StackPanel>
                </Grid>

                <local:DashboardView Name="DashboardPanel" Grid.Row="1"/>

                <local:CustomersView x:Name="CustomersPanel" Grid.Row="1" IsVisible="False" />
                <local:PetsView x:Name="PetsPanel" Grid.Row="1" IsVisible="False" />
                <ContentControl Name="MainContentRegion" Grid.Row="1" IsVisible="False"/>

            </Grid>
        </Panel>
    </Grid>
</Window>